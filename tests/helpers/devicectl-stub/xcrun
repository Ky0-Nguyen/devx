#!/bin/sh
# Extends the devicectl stub to xctrace, so the capture path can run.
#
# `record` copies a REAL trace bundle -- recorded from a macOS process on this
# host, not from any iOS device -- and `export` is forwarded to the real
# xctrace so the export and ingest are genuine. Nothing here fabricates
# measurement data: the samples are real, they are simply not from a phone,
# which is why this is a harness and not a fixture.
DIR="$(dirname "$0")"
REAL_TRACE="$DIR/donor.trace"
case "$1" in
  devicectl)
    shift; sub=""; out=""; prev=""
    for a in "$@"; do
      case "$a" in details|apps|processes) sub="$a";; devices) [ -z "$sub" ] && sub=list;; esac
      [ "$prev" = "--json-output" ] && out="$a"; prev="$a"
    done
    [ -z "$sub" ] && { echo "stub: unsupported devicectl subcommand" >&2; exit 2; }
    [ -n "$out" ] && cp "$DIR/$sub.json" "$out"
    cat "$DIR/$sub.json"; exit 0 ;;
  xctrace)
    shift
    if [ "$1" = "record" ]; then
      outdir=""; prev=""
      for a in "$@"; do [ "$prev" = "--output" ] && outdir="$a"; prev="$a"; done
      echo "Starting recording with the Time Profiler template. Attaching to: Shopper (4242)."
      echo "Ctrl-C to stop the recording"
      echo "Reached specified time limit, ending recording..."
      [ -n "$outdir" ] && { rm -rf "$outdir"; cp -R "$REAL_TRACE" "$outdir"; }
      echo "Output file saved as: $outdir"
      exit 0
    fi
    exec /usr/bin/xcrun xctrace "$@" ;;
esac
exec /usr/bin/xcrun "$@"
