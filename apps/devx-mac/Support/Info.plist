<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>DevX</string>
  <key>CFBundleDisplayName</key><string>DevX</string>
  <key>CFBundleIdentifier</key><string>com.devx</string>
  <key>CFBundleExecutable</key><string>DevX</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <!-- Generated at build time by tools/gen-icon.swift; see apps/devx-mac/CMakeLists.txt. -->
  <key>CFBundleIconFile</key><string>DevX</string>
  <key>CFBundleShortVersionString</key><string>0.2.0</string>
  <key>CFBundleVersion</key><string>2</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <!-- DevX runs device tooling (adb, xcrun) as child processes, so it is not
       sandboxed. It is a developer tool that must reach the developer's own
       toolchain; it makes no network connection of its own. -->
  <key>NSSupportsAutomaticTermination</key><false/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
</dict>
</plist>
